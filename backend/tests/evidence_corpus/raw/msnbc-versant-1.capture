																	<img loading="lazy" src="https://cdn2.nbcuni.com/NBCUniversal/styles/newsroom_stories_16_9_image_style/s3/2025-05/Screenshot%202025-05-07%20at%2012.51.55%E2%80%AFPM.png?VersionId=doDAh7EkJqshzvflW2GFTb1G_HEaevlh&amp;h=1ea5a865&amp;itok=IvtfdZFo" alt="VERSANT"/>
