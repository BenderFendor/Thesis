        Q4IdpLogin.IframeRedirectURI = "https://identity.q4inc.com/oauth/auth?response_type=code&client_id=q4-studio-public-client&redirect_uri=https%3A%2F%2Fauth.platform.q4inc.com%2Fauth%2Fv2%2FpublicAuthRedirect&scope=openid%20profile%20email&state=eyJhbGciOiJodHRwOi8vd3d3LnczLm9yZy8yMDAxLzA0L3htbGRzaWctbW9yZSNobWFjLXNoYTI1NiIsInR5cCI6IkpXVCJ9.eyJyZXR1cm5VcmwiOiJodHRwczovL2lyLndiZC5jb20vUTRJZHBMb2dpbkNhbGxiYWNrLmFzcHgiLCJleHAiOjE3OTI0MzA2OTkuMCwiaWF0IjoxNzg0NjU0Njk5LjAsImlzcyI6IlE0LldlYi5QdWJsaWMuU2l0ZSIsImF1ZCI6InVwc3RyZWFtLmNkbi53ZWIucHJkLnE0aW5jLmNvbSJ9.tcafBARZw6Fn1-9sYaQZapzJ2d5MOAqdaEeXkOG7DhE&prompt=none";
        (function () {
            if (window.location.hash.includes("login=true")) {
                // q4pid is set in the modal so it should already be there
                const pendoId = window.localStorage.getItem("q4pid");

                // email is also from modal
                const email = window.localStorage.getItem("q4l_email");

                let redirectUrl = $('#hdnRedirectToLoginUrl').val();
                redirectUrl = redirectUrl.replace("_q4pidval_", pendoId);
