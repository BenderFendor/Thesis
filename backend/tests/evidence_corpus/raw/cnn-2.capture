    <div class="module_container module_container--outer">
        
        <div class="module_container module_container--inner">
            <script>
    var q4App = $.extend(true, q4Defaults, {
        options: {
            mailingListConfig: {
                submitText: 'Sign Up'
            }
        },
        scrollingTable: function(selector) {
            $(selector).not(selector + ' table').wrap('<div class="table-wrapper" />');
        },
        meetingFancy: function($selector, trigger){
            var meetingCookie = sessionStorage.getItem('requestMeeting');
            if (meetingCookie != 'closed') {
                $selector.removeClass('js--hidden');
            }
            $selector.on('click', '.button--cookie', function () {
                $selector.addClass('js--hidden');
                sessionStorage.setItem("requestMeeting", 'closed');
            });
            $selector.on('click', trigger, function(e){
                e.preventDefault();
                $.fancybox.open({
                    type: 'iframe',
                    src: '/request-meeting-iframe/default.aspx',
                    opts: {
                        margin: [10, 0],
                        slideClass: 'fancybox-slide--form',
                        parentEl: 'form'
                    }
                });
            });
            window.addEventListener('message', function (event) {
                if (event.data == 'close-fancybox') {                
                    $.fancybox.close();
                }
            }, false);
        },
        navAccessibility: function() {
            $('nav .selected > a').attr('aria-current','page');
            $('.nav--main').attr('aria-label','primary navigation');
            $('.nav--mobile').attr('aria-label','mobile navigation');
        },
        iconFix: function(){
            $('.q4icons .module_link').each(function(){
                if (!$(this).children('.q4icons_icon').length) {
                    $(this).prepend('<span class="q4icons_icon" aria-hidden="true"></span>');
                }
            });
        },
        appendMobileNavToggles: function() {
            $('.nav--mobile .level2 > li.has-children').append('<button class="nav_section-toggle"><i class="nav_icon"></i></button>');
        },
        toggleMobileNavSections: function() {
            $('.nav--mobile .nav_section-toggle').on('click', function(e) {
                e.preventDefault();
                var $this = $(this),
                    $parent = $this.parent();
                if(!$parent.hasClass('js--open')) {
                    $parent.addClass('js--open');
                } else {
                    $parent.removeClass('js--open');
                }
            });
        },
        toggleNavSections: function() {
            var $nav = $('.nav--main .level2');

            $nav.on('click', 'li.has-children > a', function(e) {
                e.preventDefault();
                var $this = $(this),
                    $parent = $this.parent();

                if(!$parent.hasClass('js--open')) {
                    $nav.find('.js--open').removeClass('js--open');
                    $parent.addClass('js--open');
                    // remove/modify the attributes setup by the accessibleNavKeyboard() function
                    $parent.siblings().find('> ul').css('display', 'none');
                    $parent.siblings().find('> a').attr('aria-expanded', 'false');
                    $parent.find('> ul').removeAttr('style');
                    $this.attr('aria-expanded', 'true');
                } else {
                    $parent.removeClass('js--open');
                    $parent.find('> ul').css('display', 'none');
                    $this.attr('aria-expanded', 'false');
                }
            });

            // close the section on keydown
            $nav.find('li.has-children > a').on('keydown', function(e) {
                var $this = $(this),
                    $parent = $this.parent();

                if($parent.hasClass('js--open') && (e.keyCode == 37 || e.keyCode == 39)) {
                    $parent.removeClass('js--open');
                    $this.attr('aria-expanded', 'false');
                    $parent.find('> ul').css('display', 'none');
                }
            });

            // remove js--open on mouseout - accessibleNavKeyboard() issue
            $nav.find('.level3').on('mouseout', function(e) {
                $(this).parent().removeClass('js--open');
            });

            // close the section on click outside the navigation
            $('body').on('click', function(e) {
                if(!$(e.target).closest('li.has-children').length) {
                    var $openItem = $nav.find('.js--open');
                    $openItem.removeClass('js--open');
                    $openItem.find('> ul').css('display', 'none');
                    $openItem.find('> a').attr('aria-expanded', 'false');
                }
            });

        },
        mobileMenuToggle: function ($layout, pane, toggle) {
            var inst = this;
            $(toggle).attr('aria-expanded', 'false');
            $layout.on('click', toggle, function (e) {
                if ($(this).is('a, button')) e.preventDefault();
                $(toggle).attr('aria-expanded', function (i, attr) {
                    return attr == 'true' ? 'false' : 'true';
                });
                $layout.toggleClass('js--mobile');
            });
        },
        /*
            this method has been modified to allow the 
            pressing of the 'enter' key in the search input
        */
        validateSubmit: function (selector) {
            var $search = $(selector);

            // also convert input submit to buttons
            $search.each(function(){
                $submit = $(this).find('input:submit');
                $submit[0].outerHTML = $submit[0].outerHTML.replace(/^<input/, '<button') + '<span class="button_text">' + $submit[0].value + '</span></button>';
            });

            // change the type of the input from 'text' to 'search'
            $('.pane--header .module-search_input').attr('type', 'search');

            // change the type of the desired input
            $search.on('click', '[type="submit"]', function (e) {
                if (!$(this).closest(selector).find('input[type="search"]').val().length) {
                    e.preventDefault();
                    return false;
                }
            });
        },
        init: function() {
            var app = this;
    
            app.cleanUp();
            app.submitOnEnter('.module-unsubscribe');
            app.submitOnEnter('.module-search');
            app.validateSubmit('.module-search');
            app.reveal('.pane--header', '.module-search_toggle','.module-search .module_container--inner', false);
            app.toggleNavSections();
            app.mobileMenuToggle($('.layout'), '.pane--navigation', '.layout_toggle-button');
            app.appendMobileNavToggles();
            app.toggleMobileNavSections();
            app.cleanQuickLinks($('.module-links'));
            app.copyright($('.copyright_year'));
            app.reveal('.pane--footer .module-subscribe', '.module_input', '.module-subscribe_mailing-list, .module-subscribe_unsubscribe', true);
            app.docTracking();
            app.fancySignup();
            app.resetDate(['.nav a[href*="s4.q4web.com"]:not([href$=".pdf"])']);
            app.previewToolbar();
            app.sections();
            app.contrast.init();
            app.meetingFancy($('.module-cta'),'.button--meeting');
            app.iconFix();
            app.navAccessibility();
            app.accessibleNavKeyboard( '.nav--main', '2', '.nav--mobile' );
        }
    });
    
    q4App.init();
</script>
        </div>
    </div>
</div></span><span class='Q4FooterDiv18'><div id="_ctrl0_ctl58_divModuleContainer" class="module module-html hidden" data-workflow-id="feaf7e77-8334-4f09-8df1-faf0023677a4">
    <div class="module_container module_container--outer">
        
        <div class="module_container module_container--inner">
            <div id="webcast-disclaimer">
    <p><strong><u>Cautionary Statement Concerning Forward-Looking Statements</u></strong><br>
