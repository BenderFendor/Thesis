<script>
  const nav = performance.getEntriesByType('navigation')[0];

  if (nav && nav.type === 'reload' && 'scrollRestoration' in history) {
    history.scrollRestoration = 'manual';
  }
</script>

<style>
  ::selection {
    background-color: var(--_colors---secondary);
    color: var(--_colors---primary);
  }

  .wp-select {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    /* re-add an arrow — appearance:none removes the native one on every platform */
    background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' fill='none' stroke='%23aaaaaa' stroke-width='1.5'><path d='M4 6l4 4 4-4'/></svg>");
    background-repeat: no-repeat;
    background-position: right 1rem center;
    padding-right: 2.5rem;
  }

  .wp-input:focus,
  .wp-select:focus {
    outline: none;
    border-top-color: transparent;
    border-left-color: transparent;
    border-right-color: transparent;
  }

  .wp-input:-webkit-autofill,
  .wp-input:-webkit-autofill:hover,
  .wp-input:-webkit-autofill:focus,
  .wp-select:-webkit-autofill,
  .wp-select:-webkit-autofill:hover,
  .wp-select:-webkit-autofill:focus {
    -webkit-box-shadow: 0 0 0 1000px var(--_colors---primary) inset !important;
    box-shadow: 0 0 0 1000px var(--_colors---primary) inset !important;
    -webkit-text-fill-color: var(--_colors---text-primary) !important;
    caret-color: var(--_colors---text-primary);
    border-top-color: var(--_colors---primary);
    border-left-color: var(--_colors---primary);
    border-right-color: var(--_colors---primary);
  }

  /* Grayscale antialiasing — thinner, cleaner white-on-black text (macOS only) */
  .wp-main {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* Section anchor offset so links don't land under the fixed navbar */
  .wp-section {
    scroll-margin-top: 5rem; /* = navbar-height */
  }

  /* Update the svg color on hover, using an embed instead of an image as it's not supported */
  a[class^='wp-button']:active svg,
  a[class*=' wp-button']:active svg,
  a[class^='wp-button']:active svg path,
  a[class*=' wp-button']:active svg path,
  a[class^='wp-button']:active svg line,
  a[class*=' wp-button']:active svg line {
    fill: var(--_colors---primary);
    stroke: var(--_colors---primary);
  }

  /* Accent button: inset ring instead of a real border, for a crisp edge */
  .wp-button-accent {
    border: none !important;
    margin: 1px !important;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor, transparent) !important;
  }

  /* Carousel: scroll-snap track (properties Webflow's UI can't set) */
  .wp-carousel-track {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .wp-carousel-track::-webkit-scrollbar {
    display: none;
  }

  .wp-carousel-slide {
    scroll-snap-align: start;
  }

  /* Dim each arrow when there is nothing further to scroll in its direction */
  .wp-carousel .wp-is-disabled {
    opacity: 0.3;
    pointer-events: none;
  }

  .wp-accordion-trigger {
    cursor: pointer;
  }

  /* Accordion: animate the panel open/closed */
  .wp-accordion-content {
    interpolate-size: allow-keywords;
    block-size: 0;
    padding-block: 0;
    opacity: 0;
    overflow: clip;
    transition:
      block-size 0.7s cubic-bezier(0.19, 1, 0.22, 1),
      padding-block 0.7s cubic-bezier(0.19, 1, 0.22, 1),
      opacity 0.4s ease;
  }

  .wp-accordion-item.wp-is-open .wp-accordion-content {
    block-size: auto;
    padding-block: 1.5rem;
    opacity: 1;
  }

  .wp-accordion-trigger img,
  .wp-accordion-trigger svg {
    transform-origin: center;
    transition: transform 0.2s ease;
  }

  .wp-accordion-item.wp-is-open .wp-accordion-trigger img,
  .wp-accordion-item.wp-is-open .wp-accordion-trigger svg {
    transform: rotate(45deg);
  }

  /* Mobile menu overlay */
  .wp-navbar-overlay {
    position: fixed;
    height: auto !important;
    width: auto !important;
    top: 4.25rem;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 900;
    background-color: rgba(0, 0, 0, 0.5);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
  }

  .wp-navbar-menu-button.w--open ~ .wp-navbar-overlay {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .w-nav[data-animation='over-right'] .w-nav-overlay,
  .w-nav[data-animation='over-right'] [data-nav-menu-open] {
    z-index: 1000;
  }
</style>

<style>
  .wp-hero-zoom-set {
    perspective: 100vh;
    transform-style: preserve-3d;
    opacity: 0;
    position: absolute;
    height: 100%;
  }

  .wp-hero-zoom-set > *:not(.wp-hero-zoom-scene) {
    opacity: 0;
  }

  .wp-hero-zoom-set:first-child {
    opacity: 1;
  }

  .wp-hero-zoom-scene {
    opacity: 0;
  }
</style>

<style>
  /* The template card renders only as a source to clone — never shown live. */
  [data-job-template] {
    display: none !important;
  }

  .wp-is-hidden {
    display: none !important;
  }
</style>

<style>
  /* External site footer — targets the footer's own markup, not our wp- classes */
  .footer-v3 {
    & a,
    & li,
    & div {
      color: var(--_colors---text-primary);
    }

    svg path {
      fill: var(--_colors---text-primary);
    }

    div[data-orientation='vertical'] {
      border-color: var(--_colors---border-color);
    }
  }
</style>

<script>
  (function () {
    // Serve Webflow-hosted images through our own Akamai-backed proxy (imrs.php)
    // instead of Webflow's CDN, so they don't count against Webflow asset bandwidth.
    // Every URL points imrs at the FULL-SIZE original (its -p-<width> suffix stripped)
    // with impolicy=high_res and a per-URL w=<width> — imrs resizes that original down to
    // the width the URL is meant for (the srcset descriptor, or the <img> width / widest
    // variant for the fallback src), instead of us resizing an already-resized variant.
    const PROXY_ENDPOINT = 'https://www.washingtonpost.com/wp-apps/imrs.php';
    const WEBFLOW_CDN = /^https:\/\/cdn\.prod\.website-files\.com\//;
    const BG_SELECTOR = '[style*="website-files"]';

    // Webflow serves resized variants as <name>-p-<width>.<ext>; strip that suffix back
    // to the original the variant was derived from. (Assumes the source filename itself
    // doesn't end in -p-<digits> before the extension — Webflow's suffix is always last.)
    const fullSize = (url) => {
      return url.replace(/-p-\d+(\.[a-zA-Z0-9]+)$/, '$1');
    };

    // Returns the proxied URL for a Webflow asset, or null if it shouldn't change.
    // width (optional) is added as w=<width> so imrs serves the full-size at that size.
    const proxyUrl = (url, width) => {
      if (typeof url !== 'string' || url.endsWith('.svg')) {
        return null;
      }

      if (!WEBFLOW_CDN.test(url)) {
        return null;
      }

      const sizeParam = width ? `&w=${width}` : '';

      return `${PROXY_ENDPOINT}?impolicy=high_res${sizeParam}&src=${encodeURIComponent(fullSize(url))}`;
    };

    // Widest width descriptor (Nw) in a srcset, or null.
    const widestSrcsetWidth = (srcset) => {
      if (!srcset) {
        return null;
      }

      let widest = 0;

      srcset.split(',').forEach((candidate) => {
        const match = candidate.trim().match(/(\d+)w$/);

        if (match) {
          widest = Math.max(widest, parseInt(match[1], 10));
        }
      });

      return widest || null;
    };

    // Best width to request for an <img>'s fallback src: its width attribute, else its
    // widest srcset variant (the src is the full-size fallback), else its natural width.
    const imgWidth = (img) => {
      const attr = parseInt(img.getAttribute('width') || '', 10);

      if (attr > 0) {
        return attr;
      }

      const fromSrcset = widestSrcsetWidth(img.getAttribute('srcset'));

      if (fromSrcset) {
        return fromSrcset;
      }

      if (img.naturalWidth > 0) {
        return img.naturalWidth;
      }

      return null;
    };

    // Rewrite a srcset string, proxying each candidate URL and keeping its descriptor.
    // The descriptor's width (Nw) rides along as w=<width> on each proxied candidate.
    const proxySrcset = (srcset) => {
      return srcset
        .split(',')
        .map((candidate) => {
          const parts = candidate.trim().split(/\s+/);
          const descriptor = parts[1] || '';
          const width = /^\d+w$/.test(descriptor) ? parseInt(descriptor, 10) : null;
          const proxied = proxyUrl(parts[0], width);

          if (proxied) {
            parts[0] = proxied;
          }

          return parts.join(' ');
        })
        .join(', ');
    };

    // Point one <img> at the proxy once, keeping the originals for reference / revert.
    const proxyImage = (img) => {
      if (img.hasAttribute('data-original-url')) {
        return;
      }

      const proxied = proxyUrl(img.src, imgWidth(img));

      if (!proxied) {
        return;
      }

      img.setAttribute('data-original-url', img.src);
      img.src = proxied;

      if (img.srcset) {
        img.setAttribute('data-original-srcset', img.srcset);
        img.srcset = proxySrcset(img.srcset);
      }
    };

    // Rewrite an element's INLINE background-image. Designer backgrounds live in a
    // cross-origin stylesheet and can't be reached here (see the plan notes).
    const proxyBackground = (element) => {
      if (element.hasAttribute('data-original-bg')) {
        return;
      }

      const backgroundImage = element.style.backgroundImage;

      if (!backgroundImage || backgroundImage === 'none') {
        return;
      }

      // The element's rendered width, when it can be measured (0 before layout -> no w).
      const width = Math.round(element.getBoundingClientRect().width) || null;

      const rewritten = backgroundImage.replace(/url\((['"]?)(.*?)\1\)/g, (whole, quote, url) => {
        const proxied = proxyUrl(url, width);

        if (proxied) {
          return `url(${quote}${proxied}${quote})`;
        }

        return whole;
      });

      if (rewritten !== backgroundImage) {
        element.setAttribute('data-original-bg', backgroundImage);
        element.style.backgroundImage = rewritten;
      }
    };

    // Process whatever is already in the DOM.
    const proxyExisting = () => {
      document.querySelectorAll('img').forEach((img) => {
        proxyImage(img);
      });

      document.querySelectorAll(BG_SELECTOR).forEach((element) => {
        proxyBackground(element);
      });
    };

    // Catch nodes added after load: lazy images, the Instagram feed, injected markup.
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        mutation.addedNodes.forEach((node) => {
          if (node.nodeType !== 1) {
            return;
          }

          if (node.nodeName === 'IMG') {
            proxyImage(node);
          } else if (node.matches(BG_SELECTOR)) {
            proxyBackground(node);
          }

          node.querySelectorAll('img').forEach((img) => {
            proxyImage(img);
          });

          node.querySelectorAll(BG_SELECTOR).forEach((element) => {
            proxyBackground(element);
          });
        });
      });
    });

    if (document.documentElement) {
      observer.observe(document.documentElement, { childList: true, subtree: true });
    }

    proxyExisting();
  })();
</script></head><body><div data-animation="over-right" data-collapse="medium" data-duration="400" data-easing="ease" data-easing2="ease" role="banner" class="wp-navbar w-nav"><div class="wp-navbar-container"><a href="https://www.washingtonpost.com" class="wp-logo w-nav-brand"><img width="Auto" loading="lazy" alt="The Washington Post" src="https://cdn.prod.website-files.com/6840721d7e214035555b8399/6841b4e3332186207cc713a2_d0a86f1f5446c11c21bb94f7d6be5626_TWP_Logo_Inline.svg" class="wp-logo-full"/><img width="Auto" loading="lazy" alt="" src="https://cdn.prod.website-files.com/6840721d7e214035555b8399/6841b7fae7377b7e143cfa8c_WP_Logo_Monogram-LtGray.svg" class="wp-logo-mark"/></a><nav role="navigation" class="wp-navbar-menu w-nav-menu"><a href="/about" aria-current="page" class="wp-navbar-link w-nav-link w--current">About</a><a href="/careers" class="wp-navbar-link w-nav-link">Careers</a><a href="/advertising" class="wp-navbar-link w-nav-link">Advertising</a></nav><div class="wp-navbar-menu-button w-nav-button"><img loading="lazy" src="https://cdn.prod.website-files.com/6840721d7e214035555b8399/6a3083ceb33fec2be5664100_menu-button.svg" alt="" class="wp-navbar-menu-button-icon"/></div><div class="wp-navbar-overlay"></div></div></div><div class="wp-main"><div class="wp-hero-stage"><section class="wp-hero-zoom"><div id="set-1" class="wp-hero-zoom-set"><div class="wp-hero-zoom-scene"><div class="wp-hero-zoom-scene-grid"><h1 id="w-node-ab9ab9a4-a0aa-27f5-2f6f-c192f1747be3-7b9767a6" class="heading-20">Investigating today’s changing world to help you get ready for tomorrow.</h1><a id="w-node-_82b627a8-ca2f-0871-ce9c-266c1ca46ce6-7b9767a6" href="#set-2" class="wp-button-scroll w-inline-block"><div class="wp-button-scroll-icon w-embed"><svg width="32" height="17" viewBox="0 0 32 17" fill="none" xmlns="http://www.w3.org/2000/svg">
