                      <!-- Section Component -->
          
<div class="component-section">
    <div class="component-section__content centered">
        
                <div class="component-section__header">
            <h2 class="h2">Our Mission</h2>        </div>
        
                <div class="component-section__description p2">
            <p>The mission of The Walt Disney Company is to entertain, inform and inspire people around the globe through the power of unparalleled storytelling, reflecting the iconic brands, creative minds and innovative technologies that make ours the world&rsquo;s premier entertainment company.</p>
        </div>
        
        
