<style id="strategiq-landing-page-header-style">.block-landing-page-header{display:-webkit-box;display:-ms-flexbox;display:flex;-webkit-box-orient:vertical;-webkit-box-direction:normal;-ms-flex-direction:column;flex-direction:column;overflow:hidden}.block-landing-page-header.has-image.enable-letterbox .inner-container{aspect-ratio:375/200}@media (min-width: 768px){.block-landing-page-header.has-image.enable-letterbox .inner-container{aspect-ratio:1600/477;overflow:hidden;display:-webkit-box;display:-ms-flexbox;display:flex;-webkit-box-align:center;-ms-flex-align:center;align-items:center}}@media (min-width: 768px){.block-landing-page-header.has-image.enable-letterbox .block-landing-page-header__image{height:100%}}@media (min-width: 768px){.block-landing-page-header.has-image.enable-letterbox .block-landing-page-header__image img{height:100%}}.block-landing-page-header .video-item{background-color:#000}.block-landing-page-header .video-item.enable-letterbox{height:auto;aspect-ratio:auto}.block-landing-page-header .video-item.enable-letterbox .video-inner{aspect-ratio:375/200}@media (min-width: 768px){.block-landing-page-header .video-item.enable-letterbox .video-inner{aspect-ratio:1600/477;overflow:hidden;display:-webkit-box;display:-ms-flexbox;display:flex;-webkit-box-align:center;-ms-flex-align:center;align-items:center}}@media (min-width: 768px){.block-landing-page-header .video-item.enable-letterbox .video-inner iframe{width:100% !important;height:auto !important;min-height:100% !important;position:absolute;top:50%;-webkit-transform:translateY(-50%);transform:translateY(-50%);aspect-ratio:16/9}}.block-landing-page-header.letterbox-top .video-inner video{-o-object-position:top;object-position:top}.block-landing-page-header.letterbox-bottom .video-inner video{-o-object-position:bottom;object-position:bottom}.block-landing-page-header.letterbox-top .block-landing-page-header__image img{-o-object-position:top;object-position:top}.block-landing-page-header.letterbox-bottom .block-landing-page-header__image img{-o-object-position:bottom;object-position:bottom}.block-landing-page-header .video-item--iframe iframe{pointer-events:initial}.block-landing-page-header__image{display:-webkit-box;display:-ms-flexbox;display:flex;aspect-ratio:16/7;-webkit-box-flex:1;-ms-flex-positive:1;flex-grow:1}.block-landing-page-header__image img{width:100%;-o-object-fit:cover;object-fit:cover}.block-landing-page-header iframe{-webkit-box-sizing:border-box;box-sizing:border-box;width:100%;pointer-events:none;min-height:100%}.block-landing-page-header video{width:100%;min-height:100%;-o-object-fit:cover;object-fit:cover;pointer-events:none}.block-landing-page-header .inner-container{width:100%;height:100%;position:relative;margin:0 auto;-webkit-box-flex:1;-ms-flex-positive:1;flex-grow:1;display:-webkit-box;display:-ms-flexbox;display:flex;overflow:hidden}.block-landing-page-header .video-container{width:100%;height:100%;overflow:hidden;aspect-ratio:16/7}.block-landing-page-header .video-container iframe{height:unset !important;aspect-ratio:16/9}.block-landing-page-header .cta-bar-wrapper-right{max-width:100%}.block-landing-page-header .image-credit{max-width:calc(100% - 10.25rem)}@media (min-width: 768px){.block-landing-page-header .image-credit{max-width:100%;bottom:4rem}}@media (min-width: 992px){.block-landing-page-header .image-credit{bottom:4rem}}@media (min-width: 1300px){.block-landing-page-header .image-credit{bottom:1rem}}

/*# sourceMappingURL=block-landing-page-header.css.map */
</style>
