{
  "$schema": "https://json.schemastore.org/knip.json",
  "entry": [
    "app/layout.tsx",
    "app/page.tsx",
    "app/**/page.tsx",
    "components/**/*.{ts,tsx}",
    "next.config.mjs",
    "jest.config.js",
    "jest.setup.js",
    "postcss.config.mjs",
    "app/globals.css"
  ],
  "project": [
    "**/*.{js,mjs,ts,tsx}"
  ],
  "ignore": [
    "lib/generated/**",
    ".next/**",
    "coverage/**",
    "tools/**"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "tw-animate-css"
  ]
}
