{
  "schema_version": 1,
  "policy_version": "1",
  "repository": "Thesis",
  "source_scope": {
    "version": "2026-09-01",
    "roots": [
      "backend/app",
      "backend/scripts",
      "backend/tests",
      "frontend/app",
      "frontend/components",
      "frontend/features",
      "frontend/hooks",
      "frontend/lib",
      "scripts"
    ],
    "extensions": [
      ".cjs",
      ".js",
      ".jsx",
      ".mjs",
      ".py",
      ".rs",
      ".ts",
      ".tsx"
    ],
    "exclude_directories": [
      ".next",
      ".quality-hardening",
      ".venv",
      "__mocks__",
      "__pycache__",
      "coverage",
      "generated",
      "node_modules",
      "target",
      "tools"
    ],
    "exclude_test_files": false
  },
  "analyzers": {
    "cccc": {
      "version": "1.6.0",
      "native_config": "cccc.toml",
      "command": [
        "bash",
        "scripts/check-complexity",
        "--json"
      ],
      "output_limit_bytes": 52428800
    },
    "oxlint": {
      "version": "1.80.0",
      "native_config": ".oxlintrc.json",
      "command": [
        "frontend/node_modules/.bin/oxlint",
        "-c",
        ".oxlintrc.json",
        "--format",
        "json"
      ],
      "output_limit_bytes": 52428800
    },
    "crap": {
      "version": "0.5.0",
      "working_directory": "frontend",
      "command": [
        "node_modules/.bin/crap-typescript"
      ],
      "output_limit_bytes": 52428800
    }
  },
  "thresholds": {
    "mi": {
      "cluster_floor": 50,
      "final_floor": 60
    },
    "crap": {
      "legacy_observation_line": 30,
      "cluster_ceiling": 8,
      "target": 6
    },
    "cccc": {
      "cyclomatic_ceiling": 10,
      "cognitive_ceiling": 15
    },
    "lint": {
      "errors": 0,
      "warnings": 0
    },
    "duplication_percent": 3
  },
  "verification": {
    "defaults": {
      "output_limit_bytes": 2000000,
      "timeout_ms": 300000
    },
    "checks": {
      "backend-mypy": {
        "command": [
          "bash",
          "-lc",
          "cd backend && MYPYPATH=. .venv/bin/mypy --explicit-package-bases app --strict"
        ],
        "label": "backend mypy"
      },
      "backend-tests": {
        "command": [
          "bash",
          "-lc",
          "cd backend && .venv/bin/pytest tests -m 'not slow'"
        ],
        "label": "backend tests"
      },
      "cccc": {
        "command": [
          "bash",
          "scripts/check-complexity"
        ],
        "label": "CCCC complexity"
      },
      "cli-schema": {
        "command": [
          "npm",
          "run",
          "cli:schema:check"
        ],
        "label": "CLI schema parity"
      },
      "cli-tests": {
        "command": [
          "npm",
          "run",
          "cli:test"
        ],
        "label": "CLI tests"
      },
      "cli-typecheck": {
        "command": [
          "npm",
          "run",
          "cli:typecheck"
        ],
        "label": "CLI typecheck"
      },
      "controller-tests": {
        "command": [
          "npm",
          "run",
          "quality:controller:test"
        ],
        "label": "controller tests"
      },
      "controller-typecheck": {
        "command": [
          "npm",
          "run",
          "cli:typecheck"
        ],
        "label": "controller typecheck"
      },
      "crap": {
        "command": [
          "npm",
          "--prefix",
          "frontend",
          "run",
          "crap"
        ],
        "label": "CRAP"
      },
      "cycles": {
        "command": [
          "bash",
          "scripts/check-cycles"
        ],
        "label": "cycles"
      },
      "deadcode": {
        "command": [
          "npm",
          "--prefix",
          "frontend",
          "run",
          "deadcode"
        ],
        "label": "dead code"
      },
      "duplication": {
        "command": [
          "npm",
          "run",
          "quality:duplicates"
        ],
        "label": "duplication"
      },
      "frontend-build": {
        "command": [
          "npm",
          "--prefix",
          "frontend",
          "run",
          "build"
        ],
        "label": "frontend build"
      },
      "frontend-tests": {
        "command": [
          "npm",
          "--prefix",
          "frontend",
          "test",
          "--",
          "--runInBand"
        ],
        "label": "frontend tests"
      },
      "frontend-typecheck": {
        "command": [
          "npm",
          "--prefix",
          "frontend",
          "exec",
          "--",
          "tsc",
          "-p",
          "frontend/tsconfig.json",
          "--noEmit"
        ],
        "label": "frontend typecheck"
      },
      "frontend-lint": {
        "command": [
          "npm",
          "--prefix",
          "frontend",
          "run",
          "lint"
        ],
        "label": "Oxlint"
      },
      "rust-clippy": {
        "command": [
          "cargo",
          "clippy",
          "--manifest-path",
          "backend/rss_parser_rust/Cargo.toml",
          "--",
          "-D",
          "warnings"
        ],
        "label": "Rust clippy"
      },
      "rust-extension": {
        "command": [
          "bash",
          "-lc",
          "cd backend/rss_parser_rust && uv run maturin develop --release"
        ],
        "label": "Rust extension"
      },
      "rust-format": {
        "command": [
          "cargo",
          "fmt",
          "--manifest-path",
          "backend/rss_parser_rust/Cargo.toml",
          "--all",
          "--",
          "--check"
        ],
        "label": "Rust format"
      },
      "ruff": {
        "command": [
          "uvx",
          "ruff@0.15.22",
          "check",
          "backend/"
        ],
        "label": "Ruff check"
      },
      "ruff-format": {
        "command": [
          "uvx",
          "ruff@0.15.22",
          "format",
          "--check",
          "backend/"
        ],
        "label": "Ruff format"
      },
      "custom-oxlint-tests": {
        "command": [
          "npm",
          "--prefix",
          "frontend",
          "run",
          "test:oxlint-rules"
        ],
        "label": "custom Oxlint tests"
      },
      "maintainability": {
        "command": [
          "node",
          "scripts/check-maintainability.mjs",
          "--strict"
        ],
        "label": "maintainability"
      },
      "file-lines": {
        "command": [
          "node",
          "scripts/check-file-lines.mjs"
        ],
        "label": "source line limits"
      }
    }
  },
  "profiles": {
    "path": [
      "controller-tests",
      "controller-typecheck"
    ],
    "task": [
      "controller-tests",
      "controller-typecheck"
    ],
    "changed": [
      "cycles",
      "cli-typecheck",
      "cli-tests",
      "cli-schema"
    ],
    "repo": [
      "file-lines",
      "imports",
      "cycles",
      "duplication",
      "maintainability",
      "cccc",
      "deadcode",
      "crap",
      "frontend-typecheck",
      "frontend-build",
      "frontend-lint",
      "cli-typecheck",
      "cli-tests",
      "cli-schema",
      "backend-mypy",
      "ruff",
      "ruff-format",
      "rust-clippy",
      "rust-format",
      "rust-extension",
      "frontend-tests",
      "custom-oxlint-tests",
      "backend-tests"
    ]
  },
  "ledger": {
    "directory": "docs/agents/quality-hardening/ledger",
    "raw_directory": ".quality-hardening/measurements"
  },
  "adapter": {
    "protocol_version": 1
  }
}