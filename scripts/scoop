#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ "${1:-}" == "evidence" && "${2:-}" == "replay" ]]; then
  shift 2
  PYTHON_BIN="$ROOT_DIR/backend/.venv/bin/python"
  if [[ ! -x "$PYTHON_BIN" ]]; then
    PYTHON_BIN="python3"
  fi
  cd "$ROOT_DIR/backend"
  exec "$PYTHON_BIN" -m app.scripts.replay_evidence_corpus "$@"
fi
exec node "$ROOT_DIR/scripts/scoop.ts" "$@"
