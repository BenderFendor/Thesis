{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "typeRoots": [
      "../frontend/node_modules/@types"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "quality-hardening.mjs",
    "quality-hardening/**/*.mjs",
    "scoop.ts",
    "tests/**/*.ts",
    "quality-hardening/**/*.d.ts"
  ]
}
